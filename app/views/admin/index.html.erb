<h1>Admin page</h1>

<nav class="navigation">
  <%= link_to "Back", movies_path, class: "button button-secondary" %>
  <%= link_to "New movie", new_movie_path, class: "button" %>
  <%= link_to "New screen room", new_screen_room_path, class: "button" %>
</nav>

<div id="movies">
  <% @movie.each do |movie| %>
    <article class="movie">
      <h2><%= movie.name %></h2>

      <p><strong>Description:</strong> <%= movie.description %></p>
      <p><strong>Genre:</strong> <%= movie.genre %></p>
      <p><strong>Duration:</strong> <%= movie.duration %> minutes</p>
      <p><strong>In cinemas:</strong>
        <%= movie.start_date %>
        –
        <%= movie.end_date %>
      </p>

      <div class="actions">
        <%= link_to "Add screening",
                    new_screening_path(movie_id: movie.id),
                    class: "button" %>

        <%= link_to "Edit movie",
                    edit_movie_path(movie),
                    class: "button button-secondary" %>

        <%= button_to "Delete movie",
                      movie_path(movie),
                      method: :delete,
                      class: "button-danger",
                      data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </article>

    <section class="screenings">
      <h3>Screenings</h3>

      <% if movie.screenings.any? %>
        <% movie.screenings.each do |screening| %>
          <article class="screening">
            <p>
              <strong>Starts at:</strong>
              <%= screening.starts_at.strftime("%d. %m. %Y %H:%M") %>
            </p>

            <p>
              <strong>Screen room:</strong>
              <%= screening.screen_room.room_number %>
            </p>

            <p>
              <strong>Available seats:</strong>
              <%= screening.available_seats %>
            </p>

            <div class="actions">
              <%= link_to "Edit screening",
                          edit_screening_path(screening),
                          class: "button button-secondary" %>

              <%= button_to "Delete screening",
                            screening_path(screening),
                            method: :delete,
                            class: "button-danger",
                            data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </article>
        <% end %>
      <% else %>
        <p>No screenings.</p>
      <% end %>
    </section>
  <% end %>
</div>

<h1>Reservations</h1>

<div id="reservations">
  <% @reservation.each do |reservation| %>
    <article class="reservation">
      <p>Reservation email: <%= reservation.email_address %></p>
      <p>Number of seats: <%= reservation.number_of_seats %></p>
      <%= link_to "Edit reservation", edit_reservation_path(reservation),
                  class: "button button-secondary" %>

      <%= button_to "Delete reservation",
                    reservation_path(reservation),
                    method: :delete,
                    class: "button-danger",
                    data: { turbo_confirm: "Are you sure?" } %>
    </article>
  <% end %>
</div>

<h1>Screening rooms</h1>

<div id="screen-rooms">
  <% @screening_room.each do |screening_room| %>
    <% cache screening_room do %>
      <article class="screen-room">
        <p>Room number: <%= screening_room.room_number %></p>
        <p>Number of seats: <%= screening_room.number_of_seats %></p>
        <%= link_to "Edit screening room", edit_screen_room_path(screening_room),
                    class: "button button-secondary" %>

        <%= button_to "Delete screening room",
                      screen_room_path(screening_room),
                      method: :delete,
                      class: "button-danger",
                      data: { turbo_confirm: "Are you sure?" } %>
      </article>
    <% end %>
  <% end %>
</div>