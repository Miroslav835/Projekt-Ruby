<div class="page-header">
  <h1>Filmy</h1>

  <% if authenticated? %>
    <%= link_to "Administrace", admin_path, class: "button button-secondary" %>
  <% end %>
</div>

<div class="movie-grid">
  <% @movies.each do |movie| %>
    <%= link_to movie_path(movie), class: "movie-link-card" do %>
      <h2><%= movie.name %></h2>

      <p>
        <strong>Žánr:</strong>
        <%= movie.genre %>
      </p>

      <p>
        <strong>Délka:</strong>
        <%= movie.duration %> minut
      </p>

      <p>
        <strong>Počet promítání:</strong>
        <%= movie.screenings.size %>
      </p>
    <% end %>
  <% end %>
</div>