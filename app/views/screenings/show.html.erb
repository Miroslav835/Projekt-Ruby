<h1><%= @screening.movie.name %></h1>

<p>
  Start:
  <%= @screening.starts_at %>
</p>

<p>
  Screen room:
  <%= @screening.screen_room.room_number %>
</p>

<p>
  Available seats:
  <%= @screening.available_seats %> / <%= @screening.screen_room.number_of_seats %>
</p>

<h2>Reservation</h2>

<%= render "reservations/form", reservation: @reservation %>

<div class="actions">
  <%= link_to "Back", movie_path(@screening.movie), class: "button button-secondary" %>
</div>